# Use .env.local for your own setup. The submission uses .env.review.
# Set the private owner credentials before signing in to the manager dashboard.
RELAY_OWNER_ID=relay-owner
RELAY_OWNER_PASSWORD=

# Default: callbacks run automatically and PAN, GST and bank checks are mandatory.
# RELAY_VERIFICATION_MODE=hold
# RELAY_REQUIRE_GST=false

# Uncomment to use OpenRouter free vision models for fictional demo documents.
# EXTRACTION_PROVIDER=openrouter
# OPENROUTER_API_KEY=

# Ollama Cloud is the default when EXTRACTION_PROVIDER is unset.
OLLAMA_API_KEY=
# Optional overrides. Cloud defaults to gemma4 and local defaults to gemma4:e4b.
# OLLAMA_MODE=cloud
# OLLAMA_MODEL=gemma4
# OLLAMA_LOCAL_URL=http://127.0.0.1:11434
